{
    "name": "nim_rln_consumer",
    "version": "0.1.0",
    "description": "RlnConsumer - Nim mock of logos-delivery's RLN integration, for e2e acceptance tests",
    "author": "Logos Core Team",
    "type": "core",
    "category": "protocol",
    "interface": "universal",
    "concurrency": "multi",
    "main": "nim_rln_consumer_plugin",
    "codegen": {
        "impl_header": "rln_consumer_plugin.h"
    },
    "dependencies": [],
    "include": [
        "librlnconsumer.so",
        "librlnconsumer.dylib",
        "librlnconsumer.dll"
    ],
    "capabilities": [],
    "nix": {
        "packages": {
            "runtime": ["nlohmann_json"]
        },
        "external_libraries": [
            {
                "name": "rlnconsumer",
                "build_command": "true"
            }
        ],
        "cmake": {
            "extra_include_dirs": ["lib"]
        }
    }
}
