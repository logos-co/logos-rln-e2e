# two-registries — one liblogos_rln_module holding memberships in TWO
# registries on one chain at different epochs: the delivery tree (600 s) and
# the mix tree (10 s). Direct module calls; no delivery.
NODES=1
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module rln_gifter_module libp2p_module"
TARGETS="local"
# The target provisions the mix tree beside the default one (profiles/
# local-default/tree-mix.txt) on the same programs.
REGISTRIES="default mix"
RUNNER=bash
