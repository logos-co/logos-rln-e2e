# delivery-two-registries-selfstart — the delivery module starts the RLN
# backend ITSELF for two registries from its preset: Relay on the delivery
# tree (600 s) and native Mix on the mix tree (10 s), one start() naming
# both, the mix conf keys supplied from the preset. n1 sends to n2 through
# proof-gated relay; n3 is the control whose preset puts the mix tree at the
# wrong epoch, so its Mix start must fail.
NODES=3
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module rln_gifter_module libp2p_module"
TARGETS="local"
REGISTRIES="default mix"
RUNNER=bash
