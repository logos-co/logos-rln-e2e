# delivery — two RLN-gated logos-delivery-module nodes over the Messaging API:
# both register a membership, peer statically, send one message and confirm the
# sender's epoch quota was consumed. Needs a faucet-funded deployment
# (E2E_FUNDING=faucet).
NODES=2
NEEDS_MODULES="lez_core liblogos_lez_rln_module liblogos_rln_module delivery_module"
TARGETS="local testnet"
RUNNER=bash
