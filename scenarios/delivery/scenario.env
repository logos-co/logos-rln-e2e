# delivery — 3-daemon co-residency + relay scaffold: every daemon loads the
# full RLN module stack alongside delivery_module, and the three delivery
# nodes form a static-peer gossipsub mesh exchanging messages over relay.
# Chainless for now (TARGETS=none); local/testnet join once RLN-gated
# delivery exists to exercise against a chain.
NODES=3
NEEDS_MODULES="lez_core liblogos_lez_rln_module liblogos_rln_module delivery_module"
TARGETS="none"
RUNNER=bash
