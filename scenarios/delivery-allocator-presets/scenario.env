# delivery-allocator-presets — a delivery node DISCOVERS the deployment's
# membership allocator from a preset that names none, bootstrapped either by
# plugin kademlia discovery (the conf's kadBootstrapNodes) or by the preset's
# allocator-bootstrap-nodes alone, so a never-funded node gets its relay AND
# mix memberships through the allocation protocol from createNode alone; a
# node without bootstrap peers whose configured allocator cannot be reached
# falls back to the funded registration.
NODES=6
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module libp2p_module rln_gifter_module rln_auth_module"
TARGETS="local"
# The target provisions the mix tree beside the default one (profiles/
# local-default/tree-mix.txt) on the same programs.
REGISTRIES="default mix"
PREFLIGHT_ANY="DELIVERY_LGX|DELIVERY_MODULE_CHECKOUT LIBP2P_LGX|LIBP2P_MODULE_CHECKOUT GIFTER_LGX|GIFTER_CHECKOUT AUTH_LGX|GIFTER_CHECKOUT"
PREFLIGHT_MSG="needs logos-delivery-module >= 0.3.7 (DELIVERY_LGX or DELIVERY_MODULE_CHECKOUT), libp2p_module >= 1.1.0 and logos-rln-gifter at refactor/auth-vector-pipeline (GIFTER_CHECKOUT) — see run.sh header"
RUNNER=bash
