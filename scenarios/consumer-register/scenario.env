# consumer-register — the register scenario's lifecycle driven through
# nim_rln_consumer (the Nim mock of logos-delivery) instead of direct module
# calls: every RLN operation crosses harness -> C++ plugin -> Nim ->
# mirrored delivery seam -> lp -> liblogos_rln_module. Funding and keystore
# unlock stay direct module calls (harness domain, not consumer domain).
NODES=1
NEEDS_MODULES="lez_core liblogos_lez_rln_module liblogos_rln_module nim_rln_consumer"
TARGETS="local testnet"
RUNNER=bash
