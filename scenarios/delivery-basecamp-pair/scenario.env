# delivery-basecamp-pair — TWO Basecamp instances, each with its own wallet,
# its own derived payer and its own provisioned membership, sending a
# proof-gated message to each other. No logoscore daemon anywhere: both peers
# are the desktop app with an embedded core, which is the one topology none of
# the other scenarios covers — every other Basecamp rung pairs the app with a
# daemon that does half the work.
#
# NODES=0 for that reason. The only thing outside the two apps is the chain.
NODES=0
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module"
NEEDS_APPS="basecamp"
TARGETS="local testnet"
PREFLIGHT_ANY="DELIVERY_LGX|DELIVERY_MODULE_CHECKOUT DELIVERY_LGX|LOGOS_DELIVERY_CHECKOUT BASECAMP_APP|BASECAMP_CHECKOUT"
PREFLIGHT_MSG="needs the logos-delivery-module and logos-delivery checkouts and a basecamp checkout — see run.sh header"
RUNNER=bash
