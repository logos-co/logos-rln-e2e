# delivery-rln-reuse — delivery-rln's proof path on a membership that already
# exists on chain: n1 restores it from the vault (E2E_REUSE_VAULT) and sends,
# n2 holds none and validates. Nothing is funded or registered.
NODES=2
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module"
TARGETS="local testnet devnet"
RUNNER=bash
