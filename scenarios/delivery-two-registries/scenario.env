# delivery-two-registries — the delivery module over a backend serving two
# registries: Relay on the delivery tree (600 s epoch, from the preset) and
# native Mix on the mix tree (10 s epoch, from the host's start). n1 sends
# to n2 through proof-gated relay; n3 is the control whose backend has the
# mix tree at the wrong epoch, so its Mix start must fail.
NODES=3
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module rln_gifter_module libp2p_module"
TARGETS="local"
REGISTRIES="default mix"
RUNNER=bash
