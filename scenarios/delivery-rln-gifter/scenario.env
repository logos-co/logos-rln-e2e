# delivery-rln-gifter — a delivery node with a never-funded wallet gets its RLN
# membership through the membership allocation protocol (delegated
# registration): a separate node runs rln_gifter_module and pays from its own
# funded payer. Then the gifted membership proves a delivery message to a third
# node. chat-basecamp-gifter without chat and Basecamp.
NODES=3
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module libp2p_module rln_gifter_module"
TARGETS="local"
PREFLIGHT_ANY="LIBP2P_LGX|LIBP2P_MODULE_CHECKOUT GIFTER_LGX|GIFTER_CHECKOUT"
PREFLIGHT_MSG="needs libp2p_module (LIBP2P_LGX, e.g. the delivery flake's libp2p_module-lgx, or LIBP2P_MODULE_CHECKOUT) and the gifter (GIFTER_LGX or GIFTER_CHECKOUT at fix/register-target-lez-rln-module) — see run.sh header"
RUNNER=bash
