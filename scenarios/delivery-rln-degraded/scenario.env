# delivery-rln-degraded — what an RLN-enabled delivery node does when the
# sequencer is unreachable at boot, and whether it recovers unattended once the
# chain comes back. One node: the question is provisioning and recovery, not
# the message path, so there is nothing to send to.
NODES=1
# local only, and necessarily: the fault proxy stands in front of the
# sequencer, and a hosted testnet is not ours to degrade.
TARGETS="local"
RUNNER=bash

# The defect and its fix are entirely inside the RLN module stack; the delivery
# node is the victim, not the mechanism. So the delivery leg is separable, and
# separating it is worth a knob: the RLN-only run needs no delivery bundle at
# all, which is the shortest path to knowing whether the wallet still gives up.
#
#   E2E_DEGRADED_DELIVERY=0   stop after on-chain provisioning: the proxy, the
#                             pending-not-failed assertion, unattended recovery
#                             and a real membership — no delivery stack needed
#   E2E_DEGRADED_DELIVERY=1   (default) also bring delivery up on the recovered
#                             node and wait for RLN Ready from its preset
if [ "${E2E_DEGRADED_DELIVERY:-1}" = "0" ]; then
    NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module"
else
    # No PREFLIGHT_ANY: the flake pin (delivery-module v0.3.0-rc.2) carries the
    # preset-resolved RLN the delivery leg needs, so nothing has to come from a
    # checkout. DELIVERY_MODULE_CHECKOUT / LOGOS_DELIVERY_CHECKOUT still
    # override it when you are testing an unreleased delivery tree.
    NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module"
fi
