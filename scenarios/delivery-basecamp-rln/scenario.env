# delivery-basecamp-rln — delivery_module (the protocol-0.9 build) plus the
# 0.9 RLN module stack side-loaded INSIDE Basecamp (embedded logos-core),
# driven without any consumer app: the harness calls delivery_module
# directly through the QML inspector. Basecamp registers a membership
# through liblogos_rln_module under the membership wizard's identifier,
# brings delivery up on the real rln-* conf, and sends one proof-gated
# message; an ordinary logoscore daemon (n1) validates and receives it.
# Requires the delivery checkouts and a basecamp checkout/app — see run.sh.
NODES=1
NEEDS_MODULES="lez_core liblogos_lez_rln_module liblogos_rln_module delivery_module"
NEEDS_APPS="basecamp"
TARGETS="local testnet"
# checked by run.sh before any build/bring-up: the delivery pair (or a
# prebuilt DELIVERY_LGX), the rln-modules stack, and a basecamp checkout/app.
PREFLIGHT_ANY="DELIVERY_LGX|DELIVERY_MODULE_CHECKOUT DELIVERY_LGX|LOGOS_DELIVERY_CHECKOUT RLN_LGX|RLN_MODULES_CHECKOUT BASECAMP_APP|BASECAMP_CHECKOUT"
PREFLIGHT_MSG="needs the delivery-module fork (rln/toolchain-0.9) + logos-delivery tip checkouts, the rln-modules stack and a basecamp checkout — see run.sh header"
RUNNER=bash
