# delivery-rln-soak — the delivery+RLN message path under sustained load. Two
# logos-core nodes send to each other across several RLN epochs, deliberately
# past the per-epoch budget in each one, and the run reports latency, slot
# accounting and what becomes of the overflow. The long-running sibling of
# delivery-rln, which proves the seam's contract on three messages.
NODES=2
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module"
TARGETS="local testnet"
# No PREFLIGHT_ANY: the flake pin (delivery-module v0.3.0-rc.1) carries the
# preset-resolved RLN this scenario needs, so nothing has to come from a
# checkout. DELIVERY_MODULE_CHECKOUT / LOGOS_DELIVERY_CHECKOUT still override
# it when you are testing an unreleased delivery tree.
RUNNER=bash
