# delivery-cli — the operator's own path: a released logosctl, published catalog.
#
# n1 is installed the way a user installs. n2 is an ordinary harness node on
# the pins, so the message crosses the published stack into the one main
# builds — the interop half of what this proves.
NODES=2
# The peer's bundles. n1 takes none of these: it installs the RLN pair by
# name from the catalog through logosctl, which is the point.
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module"
# delivery_module is not in any catalog at an RLN-capable version (the
# official one stops at 0.2.1, before the bridge), so n1 installs the same
# pin the peer runs, built portable for the released logosctl.
NEEDS_DELIVERY_PORTABLE=1
TARGETS="local"
RUNNER=bash
