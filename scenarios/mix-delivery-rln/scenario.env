# mix-delivery-rln — Delivery send(Required) routed through standalone Mix
# intermediates (libp2p_mix_rln_module), every hop and every Relay frame
# RLN-protected by one shared liblogos_rln_module backend per host. Follows the
# operator doc "Run a Logos Mixnet node from the CLI" (testnet v0.3). Ported
# from logos-libp2p-mix-rln tests/integration_e2e/shared_delivery_mix.
NODES=7
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module libp2p_mix_rln_module"
# Native Mix on a shared backend, manage-backend=false and Mix peer records are
# logos-delivery-module#148 (unmerged); back to the main pin once released.
DELIVERY_FLAKE=github:richard-ramos/logos-delivery-module/ca1fe40c665b412c5d477020f3c38c33854d5054
# Hosts are released logosctl daemons: they take portable bundles.
LGX_VARIANT=portable
TARGETS="local"
RUNNER=bash
