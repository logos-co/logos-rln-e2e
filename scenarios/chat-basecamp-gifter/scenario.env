# chat-basecamp-gifter — logos-chat INSIDE Basecamp registering through the
# RLN membership allocation protocol: a separate logoscore daemon (n2) runs
# the allocation service (libp2p_module + rln_gifter_module serving an OPEN
# gifter from a faucet-funded holding); Basecamp's chat node — a FRESH,
# never-funded wallet — registers with {"delegated":"true","gifter_peer_id",
# "gifter_multiaddr"} in rln-relay-registry-options, the gifter pays, and
# the proof-gated chat message reaches the verifier (n1) as in
# chat-basecamp-rln. Requires the fork checkouts — see run.sh header.
NODES=2
NEEDS_MODULES="lez_core liblogos_lez_rln_module liblogos_rln_module libp2p_module rln_gifter_module delivery_module chat_module"
NEEDS_APPS="basecamp"
TARGETS="testnet"
PREFLIGHT_ANY="DELIVERY_LGX|DELIVERY_MODULE_CHECKOUT DELIVERY_LGX|LOGOS_DELIVERY_CHECKOUT RLN_LGX|RLN_MODULES_CHECKOUT CHAT_LGX|CHAT_MODULE_CHECKOUT BASECAMP_APP|BASECAMP_CHECKOUT LIBP2P_LGX|LIBP2P_MODULE_CHECKOUT GIFTER_LGX|GIFTER_CHECKOUT"
PREFLIGHT_MSG="needs the rln/integration-fixes delivery checkouts, the chat-module fork (rln/e2e-extra-conf), the 0.7 rln-modules stack, a basecamp checkout, the libp2p module checkout and the gifter checkout (fix/register-target-lez-rln-module) — see run.sh header"
RUNNER=bash
