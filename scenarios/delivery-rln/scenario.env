# delivery-rln — logos-delivery's RLN integration driven against the REAL RLN
# module stack. Bring-up goes through the node's RLN preset (the upstream
# door since logos-delivery-module#118; no rln-* conf key and no configureRln), n1 registers and sends, n2 validates and
# receives, and a witness responder on n2 proves an external answer cannot
# hijack the in-process bridge's verdict.
NODES=2
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module"
TARGETS="local testnet"
# No PREFLIGHT_ANY: the flake pin (delivery-module v0.3.0-rc.2) carries the
# preset-resolved RLN this scenario needs, so nothing has to come from a
# checkout. DELIVERY_MODULE_CHECKOUT / LOGOS_DELIVERY_CHECKOUT still override
# it when you are testing an unreleased delivery tree.
RUNNER=bash
