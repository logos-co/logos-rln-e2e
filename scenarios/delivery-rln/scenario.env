# delivery-rln — the delivery team's impl-plugable-rln-api-module branches
# driven against the REAL RLN module stack, with the harness playing the
# RLN responder (delivery_module re-emits its library's RLN requests as
# rln*Request events; whoever answers calls rlnRespond).
# Requires the delivery fork checkouts — see run.sh header.
NODES=1
NEEDS_MODULES="lez_core liblogos_lez_rln_module liblogos_rln_module delivery_module"
TARGETS="local testnet"
RUNNER=bash
