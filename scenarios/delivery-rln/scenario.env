# delivery-rln — logos-delivery's RLN integration driven against the REAL RLN
# module stack. Bring-up goes through delivery_module's configureRln (the
# upstream door; no rln-* conf key), n1 registers and sends, n2 validates and
# receives, and a witness responder on n2 proves an external answer cannot
# hijack the in-process bridge's verdict.
NODES=2
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module"
TARGETS="local testnet"
# checked by run.sh before any build/bring-up. The flake pins delivery-module
# at a rev that predates the RLN bridge, so the delivery stack must come from
# a checkout (or a prebuilt bundle). The rln-modules pin is current — no
# checkout needed for the module stack.
PREFLIGHT_ANY="DELIVERY_LGX|DELIVERY_MODULE_CHECKOUT DELIVERY_LGX|LOGOS_DELIVERY_CHECKOUT"
PREFLIGHT_MSG="see docs/delivery-integration.md quickstart for the exact checkouts"
RUNNER=bash
