# delivery-rln — the delivery team's impl-plugable-rln-api-module branch (+
# the rln/integration-fixes stacks) driven against the REAL RLN module stack,
# with the harness playing the RLN responder (delivery_module re-emits its
# library's RLN requests as rln*Request events; a background responder per
# node answers via rlnRespond). n1 registers and sends; n2 validates and
# receives. Requires the integration checkouts — see run.sh header.
NODES=2
NEEDS_MODULES="lez_core liblogos_lez_rln_module liblogos_rln_module delivery_module"
TARGETS="local testnet"
# checked by run.sh before any build/bring-up: a prebuilt DELIVERY_LGX, or
# BOTH delivery checkouts; and the 0.6.1 rln-modules stack (flake pin is older)
PREFLIGHT_ANY="DELIVERY_LGX|DELIVERY_MODULE_CHECKOUT DELIVERY_LGX|LOGOS_DELIVERY_CHECKOUT RLN_LGX|RLN_MODULES_CHECKOUT"
PREFLIGHT_MSG="see docs/delivery-integration.md quickstart for the exact checkouts/branches"
RUNNER=bash
