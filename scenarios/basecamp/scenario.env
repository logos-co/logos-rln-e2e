# basecamp — stand up two Basecamp instances with the delivery + RLN module
# stack and both UIs installed, and leave them running for manual testing.
# Drives no nodes itself: the logoscore CLI cannot attach to Basecamp, which
# embeds liblogos in-process and hosts no daemon endpoint of its own. The
# `delivery` scenario is the automated test.
NODES=0
NEEDS_MODULES="lez_core liblogos_lez_rln_module liblogos_rln_module delivery_module"
TARGETS="local testnet"
RUNNER=bash
