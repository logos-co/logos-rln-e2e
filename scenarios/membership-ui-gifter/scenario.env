# membership-ui-gifter — the RLN membership UI (rln_membership_ui) mounted in
# headless Basecamp, and the delegated registration it drives: an allocator
# (n2: rln_gifter_module + eth_auth_module, eth-allowlist) pays for a
# membership whose request is signed by Basecamp's eth_sign_module.
NODES=2
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module libp2p_module rln_gifter_module"
NEEDS_APPS="basecamp"
TARGETS="local testnet"
PREFLIGHT_ANY="BASECAMP_APP|BASECAMP_CHECKOUT LIBP2P_LGX|LIBP2P_MODULE_CHECKOUT GIFTER_LGX|GIFTER_CHECKOUT"
PREFLIGHT_MSG="needs UI_LGX, ETH_SIGN_LGX, ETH_AUTH_LGX, KEYCARD_CAPTURE_LGX, a basecamp app or checkout, the libp2p module and the gifter — see run.sh header"
RUNNER=bash
