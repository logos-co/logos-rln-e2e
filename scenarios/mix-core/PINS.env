# shellcheck shell=bash
# shellcheck disable=SC2034  # consumed by sourcing scripts
# The logos-core mix-node stack pin: libp2p_module with the mix + RLN
# spam-protection surface, sourced from the module module — proofs come from
# liblogos_rln_module, secrets never leave it.
#
# The scenario builds the .lgx from a checkout (LIBP2P_MODULE_CHECKOUT,
# default ../logos-libp2p-module) — that checkout should sit on this rev:
LIBP2P_MODULE_REPO=https://github.com/adklempner/logos-libp2p-module
LIBP2P_MODULE_REV=feat/mix-rln-module-proofs

# Pinned INSIDE that branch's flake.lock (recorded for the review trail):
#   nim-libp2p (cbind: nim-ffi mix+rln surface)
#     adklempner/nim-libp2p @ feat/mix-rln-cbind
#   nim-libp2p-mix   adklempner/nim-libp2p-mix @ feat/master-compat
#   mix-rln-spam-protection-plugin
#     adklempner/mix-rln-spam-protection-plugin @ feat/module-proofs
#     (carries the hash_to_field_le external-nullifier alignment + the
#      frozen module-proof interop vector in tests/interop/)
