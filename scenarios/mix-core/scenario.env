# mix-core — mix over the libp2p_module (nim-libp2p cbind mix + per-hop RLN),
# proofs generated and verified by liblogos_rln_module for memberships each
# node registers itself on-chain. The mixnet counterpart of `register`: no
# pre-provisioned credentials, no wakunode stack.
NODES=5
NEEDS_MODULES="logos_execution_zone liblogos_lez_rln_module liblogos_rln_module libp2p_module"
TARGETS="local"
RUNNER=bash
