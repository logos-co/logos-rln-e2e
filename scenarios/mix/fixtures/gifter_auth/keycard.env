# Test fixtures for the gifter's KEYCARD attestation auth path — throwaway
# deterministic secp256k1 private keys consumed by the synthetic minter
# (logos-rln-gifter/tools/mint_attest.py). NOT FOR PRODUCTION. The CA public
# key is derived at runtime (mint_attest.py pub), so nothing to keep in sync.
#
#   KC_CA_PRIV           the run's trusted "vendor" CA (mounted via trustedCAs)
#   KC_CARD_PRIV         dest's synthetic card (happy path + reuse negative)
#   KC_CARD2_PRIV        second card: wrong-binding negative + rate-clamp extra
#   KC_UNTRUSTED_CA_PRIV a CA deliberately NOT mounted (untrusted-CA negative)
KC_CA_PRIV=1111111111111111111111111111111111111111111111111111111111111111
KC_CARD_PRIV=2222222222222222222222222222222222222222222222222222222222222222
KC_CARD2_PRIV=3333333333333333333333333333333333333333333333333333333333333333
KC_UNTRUSTED_CA_PRIV=4444444444444444444444444444444444444444444444444444444444444444
