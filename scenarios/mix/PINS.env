# shellcheck shell=bash
# The mix-node stack pin. A plain env file, not a flake input: wakunode2 and
# chat2mix are make/nimble targets that need a real git clone (zerokit
# submodule gitlink + nimble git-URL deps), so the harness clones this rev
# clone-and-go style (scenarios/mix/lib/stack.sh).
LOGOS_DELIVERY_REPO=https://github.com/logos-messaging/logos-delivery
LOGOS_DELIVERY_REV=b78a2c5da03eed839e34dc65143e5c96cb77ecb2  # feat/logos-testnetv02-mix

# Pinned INSIDE that rev (recorded here for the record only — do not fetch
# separately):
#   mix-rln-spam-protection-plugin  a5cb0d64890d8f55f8527013418b784b799624ba
#     (logos_delivery.nimble; nix/deps.nix still says 61ee3e5a — the nimble/
#     make path wins for our build, leave the divergence to upstream)
#   nim-libp2p-mix                  50c4ab4fa788a33eb12a0a2cecaa708873352b58
#   zerokit                         v2.0.2 (5e64cb88), built
#     --no-default-features --features stateless — same version+features as
#     liblogos_rln_module's in-crate prover
