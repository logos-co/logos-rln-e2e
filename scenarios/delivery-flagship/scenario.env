# delivery-flagship — the 0.4 release in one run: five delivery nodes hold a
# membership on the delivery tree (Relay, 600 s) and on the mix tree (native
# Mix, 10 s), obtained three ways — A: relay allocated, mix paid; B: mix
# allocated, relay paid; c1–c3: both from the discovered allocator — and RLN
# proofs are generated and validated for a relay message and for messages A
# and B send each other THROUGH the mixnet (a proof per hop on the mix tree).
NODES=7
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module libp2p_module rln_gifter_module rln_auth_module"
TARGETS="local"
REGISTRIES="default mix"
PREFLIGHT_ANY="DELIVERY_LGX|DELIVERY_MODULE_CHECKOUT LIBP2P_LGX|LIBP2P_MODULE_CHECKOUT GIFTER_LGX|GIFTER_CHECKOUT AUTH_LGX|GIFTER_CHECKOUT"
PREFLIGHT_MSG="needs logos-delivery-module >= 0.3.7 (DELIVERY_LGX or DELIVERY_MODULE_CHECKOUT), libp2p_module >= 1.1.0 and logos-rln-gifter at refactor/auth-vector-pipeline (GIFTER_CHECKOUT) — see run.sh header"
RUNNER=bash
