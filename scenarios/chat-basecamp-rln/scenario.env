# chat-basecamp-rln — logos-chat running INSIDE Basecamp (the desktop app,
# embedded logos-core, modules side-loaded into --user-dir), on the forked
# logos-delivery. Basecamp's chat node registers an RLN membership on the
# real chain (funded via the conf-fed funding pair) and sends one chat
# message; a NON-basecamp verifier (an ordinary logoscore daemon running the
# same stack + chat as peer B) receives it only after its own module
# validates the proof. Requires the fork checkouts — see run.sh header.
NODES=1
NEEDS_MODULES="lez_core liblogos_lez_rln_module liblogos_rln_module delivery_module chat_module"
NEEDS_APPS="basecamp"
TARGETS="testnet"
# checked by run.sh before any build/bring-up: the delivery fork pair (or a
# prebuilt DELIVERY_LGX), the 0.7 rln-modules stack, the chat-module fork
# (CHAT_DELIVERY_CONF_OVERRIDE support), and a basecamp checkout/app.
PREFLIGHT_ANY="DELIVERY_LGX|DELIVERY_MODULE_CHECKOUT DELIVERY_LGX|LOGOS_DELIVERY_CHECKOUT RLN_LGX|RLN_MODULES_CHECKOUT CHAT_LGX|CHAT_MODULE_CHECKOUT BASECAMP_APP|BASECAMP_CHECKOUT"
PREFLIGHT_MSG="needs the rln/integration-fixes delivery checkouts, the chat-module fork (rln/e2e-extra-conf), the 0.7 rln-modules stack and a basecamp checkout — see run.sh header"
RUNNER=bash
