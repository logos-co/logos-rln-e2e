# chat-basecamp-rln — logos-chat running INSIDE Basecamp (the desktop app,
# embedded logos-core, modules side-loaded into --user-dir), on the forked
# logos-delivery. Basecamp's chat node registers an RLN membership on the
# real chain (paid from the app's own payer) and sends one chat
# message; a NON-basecamp verifier (an ordinary logoscore daemon running the
# same stack + chat as peer B) receives it only after its own module
# validates the proof. Requires the fork checkouts — see run.sh header.
NODES=1
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module delivery_module chat_module"
NEEDS_APPS="basecamp"
TARGETS="local testnet"
# No delivery or basecamp preflight: the delivery bundle comes from the
# delivery-module v0.3.0-rc.2 pin and the app from E2E_BASECAMP_PIN
# (logos-basecamp 0.3.0), so neither needs a checkout. DELIVERY_MODULE_CHECKOUT /
# LOGOS_DELIVERY_CHECKOUT / BASECAMP_CHECKOUT / BASECAMP_APP still override them.
PREFLIGHT_ANY="CHAT_LGX|CHAT_MODULE_CHECKOUT"
PREFLIGHT_MSG="needs the chat-module fork (rln/e2e-extra-conf) — see run.sh header"
RUNNER=bash
