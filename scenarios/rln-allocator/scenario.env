# rln-allocator — a third-party membership allocator serving TWO registries
# with a persisted libp2p identity, advertised through libp2p service
# discovery and found by the clients without a configured peer id: peer-any
# (any libp2p peer, once per registry) and eth-allowlist (framed, produced by
# rln_sign_module) through the membership module's delegated
# register_membership; refusals cost the allocator nothing; the
# spent-credential record survives a restart.
NODES=4
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module libp2p_module rln_gifter_module rln_auth_module rln_sign_module"
TARGETS="local"
# The target provisions the mix tree beside the default one (profiles/
# local-default/tree-mix.txt) on the same programs.
REGISTRIES="default mix"
PREFLIGHT_ANY="LIBP2P_LGX|LIBP2P_MODULE_CHECKOUT GIFTER_LGX|GIFTER_CHECKOUT AUTH_LGX|GIFTER_CHECKOUT SIGN_LGX|GIFTER_CHECKOUT"
PREFLIGHT_MSG="needs libp2p_module >= 1.1.0 (LIBP2P_LGX or LIBP2P_MODULE_CHECKOUT) and logos-rln-gifter at refactor/auth-vector-pipeline (GIFTER_LGX/AUTH_LGX/SIGN_LGX or GIFTER_CHECKOUT) — see run.sh header"
RUNNER=bash
