# rln-allocator — a third-party RLN membership allocator end to end on a chain:
# a gifter with a persisted libp2p identity and an eth-allowlist verifier
# registers signed requests on the registry, keeps its PeerId and its spent
# credentials across a daemon restart, and pays for exactly what it grants.
# Plus the mismatch case: a client asking for a registry the gifter does not
# serve.
NODES=2
NEEDS_MODULES="liblogos_lez_rln_module liblogos_rln_module libp2p_module rln_gifter_module"
TARGETS="local"
PREFLIGHT_ANY="LIBP2P_LGX|LIBP2P_MODULE_CHECKOUT GIFTER_LGX|GIFTER_CHECKOUT ETH_AUTH_LGX"
PREFLIGHT_MSG="needs libp2p_module, rln_gifter_module (>= 0.3.0) and ETH_AUTH_LGX (logos-rln-gifter rust/eth-auth-module #lgx), plus foundry's cast — see run.sh header"
RUNNER=bash
