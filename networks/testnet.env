# networks/testnet.env — the LEZ testnet zone ("LEZ classic", protocol-compatible
# with v0.2.5-rc3: its built-in program ids match devnet zone 2's) on the Logos
# blockchain testnet (release 0.3.0).
#
# Same keys as networks/devnet.env; see docs/networks.md. Testnet has no faucet:
# the bedrock wallet is funded by PoW mining on the node (PUT /pow/mining/start
# once Online), so the fund step only ever deposits what the node already holds.

NETWORK=testnet
DEPLOYMENT=testnet-z1

# The LEZ zone.
LEZ_SEQUENCER=http://209.38.241.182:3240/
LEZ_INDEXER=http://209.38.241.182:8979/
LEZ_CHANNEL=3cfd6906e8f2468b843bddfb8c08c6d0289996508762c14e2233ba757e8d16d1

# The bedrock chain the zone settles on. Stable releases carry the testnet
# genesis and peers (.github/release/testnet-peers.txt); -rc builds are devnet.
BEDROCK_RELEASE=0.3.0
BEDROCK_PEERS="/ip4/65.109.51.37/udp/3000/quic-v1/p2p/12D3KooWFrouXfmrR4nsLMtE7wu15DoMJ6VtoUtHinREZCvbWHar
/ip4/65.109.51.37/udp/3001/quic-v1/p2p/12D3KooWJRGau8M1rjT7R5e4YYsgdFhsMX35nRDtMwCDjxQkXAHz
/ip4/65.109.51.37/udp/3002/quic-v1/p2p/12D3KooWQXJavMDTRscjauFSgVAB1VLB6Rzpy2uY5SU9Tk7927tb
/ip4/65.109.51.37/udp/50001/quic-v1/p2p/12D3KooWSQc7CcGtvWDPF1yCbBthFnQjprfCVHmfmNDUrSmqQsU1"
# Disabled on testnet (the backend answers 405); provision.sh only calls it
# when the node's wallet is short, and then fails with that answer.
FAUCET_URL=https://testnet.blockchain.logos.co/web/faucet-backend
BEDROCK_EXPLORER_API=https://testnet.blockchain.logos.co/web/explorer/api/v1
# Keep clear of a devnet node on the same machine (8080 / UDP 3000 / 3400).
BEDROCK_HTTP=127.0.0.1:8180
BEDROCK_NET_PORT=3100

# Funding policy. Mined rewards are 2.5e7 each, so deposits are small: a
# registration needs ~1.8e8 on hand at base fee 8 (chain-derived reserve) and
# provisioning ~1.7e7.
DEPOSIT_AMOUNT=200000000
PAYER_MIN=50000000

# 600 s matches logos-delivery's EVM-era twn preset.
RLN_EPOCH_SIZE_SEC=600
