# networks/devnet.env — LEZ devnet zone 2 (v0.2.5-rc3) on the Logos blockchain devnet.
#
# Everything tools/network/provision.sh needs to fund a payer and provision an
# RLN deployment on this network, and nothing secret: keys and wallets live
# under NETWORK_STATE (default ~/.local/share/logos-rln-e2e/<NETWORK>).
# testnet gets a sibling file with the same keys.

# Name used for the state dir, the e2e target (--target <NETWORK>) and the
# CAIP-2 reference in registry ids (logos:<NETWORK>:<config account hex>).
NETWORK=devnet
# The deployment descriptor this network provisions (deployments/<DEPLOYMENT>/).
DEPLOYMENT=devnet-z2

# The LEZ zone.
LEZ_SEQUENCER=http://209.38.241.182:3140/
LEZ_INDEXER=http://209.38.241.182:8879/
LEZ_CHANNEL=0202020202020202020202020202020202020202020202020202020202020202

# The bedrock chain the zone settles on, and how to reach it.
BEDROCK_RELEASE=0.3.0-rc.5
BEDROCK_PEERS="/ip4/65.108.203.235/udp/3000/quic-v1/p2p/12D3KooWNbZTQ86TZ9MrZ2wm6iUFFj25AFTzFLUD7i6XkZHoUzU8
/ip4/65.108.203.235/udp/3001/quic-v1/p2p/12D3KooWNhXaH4XTX6Pp66NDQZxZpXYQzeruwwraMvTxojz1QXPJ
/ip4/65.108.203.235/udp/3002/quic-v1/p2p/12D3KooWNTLPg5uYPKgZCDvzyaWNwZNcwVKmfS2bNv52E9L9P7Hf
/ip4/65.108.203.235/udp/50001/quic-v1/p2p/12D3KooWMULUG8RXC2esnfLcVzGHohf6KNPSswkCKa1mdpXz4tHH"
# POST <FAUCET_URL>/<zk public key hex> — drips 1e12 to that key, 5 min cooldown.
FAUCET_URL=https://devnet.blockchain.logos.co/web/faucet-backend
# Explorer API for the zone's channel (deposit visibility; optional).
BEDROCK_EXPLORER_API=https://devnet.blockchain.logos.co/web/explorer/api/v1

# Funding policy. One deposit of DEPOSIT_AMOUNT whenever the payer holds less
# than PAYER_MIN. A registration reserves ~6.5e8 and the e2e targets fund each
# node 1e9, so 5e11 lasts several hundred node-runs.
DEPOSIT_AMOUNT=500000000000
PAYER_MIN=100000000000

# The RLN parameters the deployment is used with — what a delivery preset for
# this network would carry. 600 s matches logos-delivery's EVM-era twn preset.
RLN_EPOCH_SIZE_SEC=600
